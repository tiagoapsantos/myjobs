---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout title="Perfil profissional" current="/perfil/">
  <div class="profile-page-head"><div><div class="eyebrow"><span></span>A SUA HISTÓRIA</div><h1 data-i18n="pageTitle">Perfil profissional</h1><p data-i18n="pageIntro">Construa uma base clara para o seu próximo passo profissional.</p></div><div class="profile-head-actions"><label class="language-control"><span data-i18n="language">Idioma</span><select id="profile-language" aria-label="Idioma"><option value="pt">PT</option><option value="en">EN</option></select></label><button type="button" class="button button-outline" id="clear-profile" data-i18n="clearProfile">Limpar perfil</button><button type="button" class="button button-primary" id="save-profile" data-i18n="saveProfile">Guardar perfil</button></div></div>
  <div id="profile-message" class="profile-message" role="status" aria-live="polite" hidden></div>
  <section class="profile-overview panel profile-overview-functional"><div class="profile-monogram" id="profile-monogram">JF</div><div class="profile-overview-copy"><span class="profile-overline" data-i18n="personalProfile">PERFIL PROFISSIONAL</span><h2 id="profile-display-name">O seu percurso, com clareza.</h2><p id="profile-display-subtitle" data-i18n="profileSummary">Os seus dados ficam guardados neste navegador.</p></div><div class="profile-completion"><div class="completion-ring"><span id="completion-value">0<small>%</small></span></div><span id="completion-caption">0 de 7 secções preenchidas</span></div></section>
  <div class="profile-workspace"><nav class="profile-section-nav" aria-label="Secções do perfil" id="profile-navigation"><span class="profile-nav-title" data-i18n="profileSections">SECÇÕES DO PERFIL</span><button class="profile-nav-item is-active" type="button" data-section="personal"><span class="profile-nav-index">01</span><span data-i18n="personal">Dados pessoais</span><i data-section-status="personal"></i></button><button class="profile-nav-item" type="button" data-section="areas"><span class="profile-nav-index">02</span><span data-i18n="professionalAreas">Áreas profissionais</span><i data-section-status="areas"></i></button><button class="profile-nav-item" type="button" data-section="experience"><span class="profile-nav-index">03</span><span data-i18n="experience">Experiência</span><i data-section-status="experience"></i></button><button class="profile-nav-item" type="button" data-section="education"><span class="profile-nav-index">04</span><span data-i18n="education">Formação</span><i data-section-status="education"></i></button><button class="profile-nav-item" type="button" data-section="skills"><span class="profile-nav-index">05</span><span data-i18n="skills">Competências</span><i data-section-status="skills"></i></button><button class="profile-nav-item" type="button" data-section="languages"><span class="profile-nav-index">06</span><span data-i18n="languages">Idiomas</span><i data-section-status="languages"></i></button><button class="profile-nav-item" type="button" data-section="preferences"><span class="profile-nav-index">07</span><span data-i18n="jobPreferences">Preferências de emprego</span><i data-section-status="preferences"></i></button><div class="profile-nav-footnote"><span class="profile-local-icon">⌂</span><span data-i18n="localStorageNote">Guardado apenas neste navegador</span></div></nav>
  <div class="profile-editor">
    <section class="profile-panel is-visible" data-profile-panel="personal"><div class="profile-panel-heading"><div><div class="eyebrow"><span></span><span data-i18n="section01">SECÇÃO 01</span></div><h2 data-i18n="personal">Dados pessoais</h2><p data-i18n="personalDescription">Informação de contacto e ligações profissionais.</p></div><span class="section-completion" data-panel-status="personal">Por preencher</span></div><form id="personal-form" class="profile-form-grid" novalidate><label class="profile-field field-wide"><span data-i18n="fullName">Nome completo</span><input name="fullName" autocomplete="name" maxlength="160" placeholder="Ex.: Ana Silva" data-i18n-placeholder="namePlaceholder"/></label><label class="profile-field"><span data-i18n="email">Email</span><input name="email" type="email" autocomplete="email" maxlength="254" placeholder="nome@exemplo.pt"/></label><label class="profile-field"><span data-i18n="phone">Telefone <small>(opcional)</small></span><input name="phone" type="tel" autocomplete="tel" maxlength="50" placeholder="+351 000 000 000"/></label><label class="profile-field"><span data-i18n="location">Localização</span><input name="location" autocomplete="address-level2" maxlength="120" placeholder="Ex.: Lisboa"/></label><label class="profile-field"><span data-i18n="country">País</span><input name="country" autocomplete="country-name" maxlength="120" placeholder="Ex.: Portugal"/></label><label class="profile-field"><span data-i18n="linkedin">LinkedIn <small>(opcional)</small></span><input name="linkedin" type="url" maxlength="300" placeholder="https://linkedin.com/in/…"/></label><label class="profile-field"><span data-i18n="github">GitHub <small>(opcional)</small></span><input name="github" type="url" maxlength="300" placeholder="https://github.com/…"/></label><label class="profile-field field-wide"><span data-i18n="website">Website ou portfolio <small>(opcional)</small></span><input name="website" type="url" maxlength="300" placeholder="https://…"/></label></form></section>
    <section class="profile-panel" data-profile-panel="areas"><div class="profile-panel-heading"><div><div class="eyebrow"><span></span><span data-i18n="section02">SECÇÃO 02</span></div><h2 data-i18n="professionalAreas">Áreas profissionais</h2><p data-i18n="areasDescription">Seleccione todas as áreas que lhe interessam, defina a prioridade e indique funções pretendidas.</p></div><span class="section-completion" data-panel-status="areas">Por preencher</span></div><div id="professional-areas" class="professional-area-list"></div></section>
    <section class="profile-panel" data-profile-panel="experience"><div class="profile-panel-heading"><div><div class="eyebrow"><span></span><span data-i18n="section03">SECÇÃO 03</span></div><h2 data-i18n="experience">Experiência profissional</h2><p data-i18n="experienceDescription">Adicione o seu percurso profissional, sem limite de registos.</p></div><span class="section-completion" data-panel-status="experience">Por preencher</span></div><div id="experience-list" class="profile-record-list"></div><button type="button" class="button button-outline add-record" data-add="experience"><span>＋</span><span data-i18n="addExperience">Adicionar experiência</span></button></section>
    <section class="profile-panel" data-profile-panel="education"><div class="profile-panel-heading"><div><div class="eyebrow"><span></span><span data-i18n="section04">SECÇÃO 04</span></div><h2 data-i18n="education">Formação</h2><p data-i18n="educationDescription">Registe cursos, formação e percurso académico relevantes.</p></div><span class="section-completion" data-panel-status="education">Por preencher</span></div><div id="education-list" class="profile-record-list"></div><button type="button" class="button button-outline add-record" data-add="education"><span>＋</span><span data-i18n="addEducation">Adicionar formação</span></button></section>
    <section class="profile-panel" data-profile-panel="skills"><div class="profile-panel-heading"><div><div class="eyebrow"><span></span><span data-i18n="section05">SECÇÃO 05</span></div><h2 data-i18n="skills">Competências</h2><p data-i18n="skillsDescription">Indique apenas as competências e ferramentas que quer incluir no perfil.</p></div><span class="section-completion" data-panel-status="skills">Por preencher</span></div><div id="skills-list" class="profile-record-list"></div><button type="button" class="button button-outline add-record" data-add="skills"><span>＋</span><span data-i18n="addSkill">Adicionar competência</span></button></section>
    <section class="profile-panel" data-profile-panel="languages"><div class="profile-panel-heading"><div><div class="eyebrow"><span></span><span data-i18n="section06">SECÇÃO 06</span></div><h2 data-i18n="languages">Idiomas</h2><p data-i18n="languagesDescription">Adicione os idiomas e o nível que melhor descreve o seu domínio.</p></div><span class="section-completion" data-panel-status="languages">Por preencher</span></div><div id="languages-list" class="profile-record-list"></div><button type="button" class="button button-outline add-record" data-add="languages"><span>＋</span><span data-i18n="addLanguage">Adicionar idioma</span></button></section>
    <section class="profile-panel" data-profile-panel="preferences"><div class="profile-panel-heading"><div><div class="eyebrow"><span></span><span data-i18n="section07">SECÇÃO 07</span></div><h2 data-i18n="jobPreferences">Preferências de emprego</h2><p data-i18n="preferencesDescription">Defina as condições que procura. Todos os campos são opcionais.</p></div><span class="section-completion" data-panel-status="preferences">Por preencher</span></div><form id="preferences-form" class="profile-form-grid" novalidate><fieldset class="profile-field field-wide"><legend data-i18n="modality">Modalidade <small>(pode seleccionar várias)</small></legend><div class="choice-row"><label class="choice-chip"><input type="checkbox" name="modalities" value="onsite"/><span data-i18n="onsite">Presencial</span></label><label class="choice-chip"><input type="checkbox" name="modalities" value="hybrid"/><span data-i18n="hybrid">Híbrido</span></label><label class="choice-chip"><input type="checkbox" name="modalities" value="remote"/><span data-i18n="remote">Remoto</span></label></div></fieldset><label class="profile-field field-wide"><span data-i18n="desiredLocations">Localizações pretendidas <small>(separadas por vírgulas)</small></span><input name="locations" placeholder="Lisboa, Porto"/></label><label class="profile-field field-wide"><span data-i18n="countriesAccepted">Países onde aceita trabalhar <small>(separados por vírgulas)</small></span><input name="countries" placeholder="Portugal, Espanha"/></label><fieldset class="profile-field"><legend data-i18n="contractType">Tipo de contrato</legend><div class="choice-stack"><label><input type="checkbox" name="contractTypes" value="permanent"/><span data-i18n="permanent">Sem termo</span></label><label><input type="checkbox" name="contractTypes" value="fixed-term"/><span data-i18n="fixedTerm">A termo</span></label><label><input type="checkbox" name="contractTypes" value="freelance"/><span data-i18n="freelance">Freelance</span></label><label><input type="checkbox" name="contractTypes" value="internship"/><span data-i18n="internship">Estágio</span></label></div></fieldset><fieldset class="profile-field"><legend data-i18n="workSchedule">Horário de trabalho</legend><div class="choice-stack"><label><input type="checkbox" name="schedules" value="full-time"/><span data-i18n="fullTime">Tempo inteiro</span></label><label><input type="checkbox" name="schedules" value="part-time"/><span data-i18n="partTime">Tempo parcial</span></label><label><input type="checkbox" name="schedules" value="flexible"/><span data-i18n="flexible">Flexível</span></label></div></fieldset><label class="profile-field"><span data-i18n="minimumSalary">Salário mínimo pretendido <small>(opcional)</small></span><input name="minimumSalary" type="number" min="0" step="100" placeholder="Ex.: 1800"/></label><label class="profile-field"><span data-i18n="currency">Moeda</span><select name="currency"><option value="EUR">EUR — Euro</option><option value="GBP">GBP — Libra esterlina</option><option value="USD">USD — Dólar americano</option><option value="CHF">CHF — Franco suíço</option><option value="CAD">CAD — Dólar canadiano</option><option value="AUD">AUD — Dólar australiano</option></select></label><label class="profile-field"><span data-i18n="availability">Disponibilidade para começar</span><select name="availability"><option value="" data-i18n="selectOption">Seleccione uma opção</option><option value="immediately" data-i18n="immediately">Imediatamente</option><option value="two-weeks" data-i18n="twoWeeks">Dentro de 2 semanas</option><option value="one-month" data-i18n="oneMonth">Dentro de 1 mês</option><option value="flexible" data-i18n="flexible">Flexível</option></select></label><label class="choice-chip international-choice field-wide"><input type="checkbox" name="internationalRemote"/><span data-i18n="internationalRemote">Aceito oportunidades remotas internacionais</span></label></form></section>
    <div class="profile-editor-footer"><span id="last-saved" data-i18n="notSavedYet">Ainda não guardado</span><button type="button" class="button button-primary" id="save-profile-bottom" data-i18n="saveChanges">Guardar alterações</button></div>
  </div></div>
  <dialog id="entry-dialog" class="profile-dialog"><form id="entry-form"><div class="dialog-heading"><div><div class="eyebrow"><span></span><span data-i18n="profileEntry">PERFIL PROFISSIONAL</span></div><h2 id="dialog-title">Adicionar</h2></div><button type="button" class="dialog-close" id="dialog-close" aria-label="Fechar">×</button></div><div id="dialog-fields" class="profile-form-grid"></div><div class="dialog-actions"><button type="button" class="button button-outline" id="dialog-cancel" data-i18n="cancel">Cancelar</button><button type="submit" class="button button-primary" data-i18n="save">Guardar</button></div></form></dialog>
  <script src="../../scripts/profile-page.ts"></script>
</AppLayout>

