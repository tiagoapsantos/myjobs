---
import AppLayout from '../../layouts/AppLayout.astro'; import PageHeader from '../../components/PageHeader.astro'; import Icon from '../../components/Icon.astro';
const rows=[['Perfil e preferências','Preferências de apresentação e dados do perfil.','user'],['Notificações','Como e quando receber avisos.','bell'],['Privacidade e dados','Controlo dos dados e documentos.','settings'],['Aparência','Preferências visuais da aplicação.','sparkles']];
---
<AppLayout title="Definições" current="/definicoes/"><PageHeader eyebrow="PERSONALIZAÇÃO" title="Definições" description="A estrutura para configurar a experiência MyJobs ao seu gosto."/><div class="demo-notice"><span class="demo-dot"></span><strong>Página demonstrativa</strong><span>Opções ilustrativas; ainda não alteram preferências.</span><span class="demo-label">NÃO INTERACTIVO</span></div><div class="settings-layout"><nav class="settings-nav"><span class="settings-nav-label">PREFERÊNCIAS</span><a class="settings-nav-item settings-active" href="#geral"><Icon name="grid"/> Geral</a><a class="settings-nav-item" href="#conta"><Icon name="user"/> Perfil e conta</a><a class="settings-nav-item" href="#privacidade"><Icon name="settings"/> Privacidade</a></nav><section class="panel settings-panel" id="geral"><div class="panel-heading"><div><div class="eyebrow"><span></span>ESPAÇO PESSOAL</div><h2>Preferências gerais</h2><p>Uma vista geral das opções previstas para o seu espaço.</p></div></div><div class="settings-rows">{rows.map(row=><div class="settings-row"><div class="settings-row-icon"><Icon name={row[2]}/></div><div class="settings-row-copy"><strong>{row[0]}</strong><span>{row[1]}</span></div><span class="settings-preview">Em preparação</span><Icon name="chevron" size={16}/></div>)}</div><div class="settings-footer"><span>As definições estarão disponíveis numa fase futura.</span><span class="demo-label">MODO DEMONSTRATIVO</span></div></section></div></AppLayout>
