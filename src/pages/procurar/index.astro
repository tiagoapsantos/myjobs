---
import AppLayout from '../../layouts/AppLayout.astro';
import { PROFESSIONAL_AREAS } from '../../types/profile';
---
<AppLayout title="Procurar emprego" current="/procurar/">
  <div class="job-page-heading"><div><div class="eyebrow"><span></span>DESCOBERTA</div><h1 data-job-i18n="pageTitle">Procurar emprego</h1><p data-job-i18n="pageDescription">Pesquise oportunidades demonstrativas e combine filtros para explorar as possibilidades.</p></div><div class="job-page-actions"><label class="language-control"><span data-job-i18n="language">Idioma</span><select id="job-language" aria-label="Idioma"><option value="pt">PT</option><option value="en">EN</option></select></label><a class="button button-outline" href="/myjobs/guardadas/" data-job-i18n="savedPageTitle">Oportunidades guardadas</a></div></div>
  <div class="demo-notice job-demo-notice"><span class="demo-dot"></span><strong data-job-i18n="demo">Dados demonstrativos</strong><span data-job-i18n="demoDescription">Todos os anúncios desta página são fictícios e servem para testar a pesquisa. Não representam vagas reais.</span><span class="demo-label" data-job-i18n="noExternalSources">SEM FONTES EXTERNAS</span></div>
  <section class="profile-suggestions panel"><div class="suggestion-heading"><div><div class="eyebrow"><span></span><span data-job-i18n="suggested">Sugestões do seu perfil</span></div><p id="profile-suggestion-summary" data-job-i18n="emptyProfile">O perfil não tem preferências preenchidas.</p></div><a href="/myjobs/perfil/" class="text-link" data-job-i18n="editProfile">Editar perfil</a></div><div id="profile-suggestion-chips" class="suggestion-chips"></div></section>
  <form id="job-search-form" class="search-interface" novalidate><div class="search-query-row"><div class="search-query-input"><span aria-hidden="true">⌕</span><input id="job-query" name="text" data-job-placeholder="searchPlaceholder" placeholder="Cargo, palavras-chave, empresa, localização ou competências" autocomplete="off"/><button type="button" id="clear-query" class="clear-query" aria-label="Limpar pesquisa">×</button></div><button class="button button-primary" type="submit"><span data-job-i18n="search">Pesquisar</span></button><button class="button button-outline" type="button" id="toggle-saved-searches" data-job-i18n="viewSavedSearches">Pesquisas guardadas</button><button class="button button-outline" type="button" id="open-save-search"><span data-job-i18n="saveSearch">Guardar pesquisa</span></button></div>
    <details class="filter-panel" open><summary><span><span class="filter-icon">☷</span><b data-job-i18n="filters">Filtros</b><span id="active-filter-count" class="filter-count">0</span></span><span class="filter-summary-arrow">⌄</span></summary><div class="filter-grid"><label class="filter-field"><span data-job-i18n="area">Área profissional</span><select name="area"><option value="" data-job-i18n="allAreas">Todas as áreas</option>{PROFESSIONAL_AREAS.map((area)=><option value={area}>{area}</option>)}</select></label><label class="filter-field"><span data-job-i18n="location">Localização</span><input name="location" data-job-placeholder="locationPlaceholder" placeholder="Ex.: Lisboa ou remoto"/></label><label class="filter-field"><span data-job-i18n="country">País</span><select name="country"><option value="" data-job-i18n="allCountries">Todos os países</option><option value="Portugal">Portugal</option><option value="Spain" data-job-i18n="countrySpain">Espanha</option><option value="Ireland" data-job-i18n="countryIreland">Irlanda</option><option value="United Kingdom" data-job-i18n="countryUK">Reino Unido</option></select></label><label class="filter-field"><span data-job-i18n="mode">Modalidade</span><select name="workMode"><option value="" data-job-i18n="allModes">Todas</option><option value="remote" data-job-i18n="remote">Remoto</option><option value="hybrid" data-job-i18n="hybrid">Híbrido</option><option value="onsite" data-job-i18n="onsite">Presencial</option></select></label><label class="filter-field"><span data-job-i18n="contract">Tipo de contrato</span><select name="contractType"><option value="" data-job-i18n="allContracts">Todos</option><option value="full-time" data-job-i18n="contractFull">Tempo inteiro</option><option value="part-time" data-job-i18n="contractPart">Tempo parcial</option><option value="permanent" data-job-i18n="contractPermanent">Sem termo</option><option value="fixed-term" data-job-i18n="contractFixed">A termo</option><option value="contract" data-job-i18n="contractContract">Contrato</option><option value="freelance" data-job-i18n="contractFreelance">Freelance</option><option value="internship" data-job-i18n="contractInternship">Estágio</option><option value="temporary" data-job-i18n="contractTemporary">Temporário</option></select></label><label class="filter-field"><span data-job-i18n="experience">Experiência</span><select name="experienceLevel"><option value="" data-job-i18n="allExperience">Todos</option><option value="entry" data-job-i18n="entry">Inicial</option><option value="junior" data-job-i18n="junior">Júnior</option><option value="mid" data-job-i18n="mid">Intermédio</option><option value="senior" data-job-i18n="senior">Sénior</option><option value="lead" data-job-i18n="lead">Liderança</option><option value="any" data-job-i18n="any">Qualquer nível</option></select></label><fieldset class="filter-field salary-filter"><legend data-job-i18n="salaryRange">Intervalo salarial (moeda do anúncio)</legend><div><input type="number" name="salaryMinimum" min="0" placeholder="Mín." data-job-placeholder="salaryFrom"/><span>—</span><input type="number" name="salaryMaximum" min="0" placeholder="Máx." data-job-placeholder="salaryTo"/></div></fieldset><label class="filter-field"><span data-job-i18n="published">Publicado nos últimos</span><select name="publishedWithinDays"><option value="" data-job-i18n="anyDate">Qualquer data</option><option value="1" data-job-i18n="oneDay">24 horas</option><option value="7" data-job-i18n="sevenDays">7 dias</option><option value="14" data-job-i18n="fourteenDays">14 dias</option><option value="30" data-job-i18n="thirtyDays">30 dias</option></select></label></div><div class="filter-footer"><span id="filter-feedback" aria-live="polite"></span><button type="button" class="text-button" id="clear-filters" data-job-i18n="clearFilters">Limpar filtros</button></div></details>
  </form>
  <section id="saved-searches-panel" class="saved-searches-panel panel" hidden><div class="saved-searches-heading"><div><div class="eyebrow"><span></span><span data-job-i18n="savedSearches">Pesquisas guardadas</span></div></div><button type="button" id="close-saved-searches" class="text-button" aria-label="Fechar">×</button></div><div id="saved-search-list" class="saved-search-list"></div></section>
  <section class="search-results-section"><div class="results-toolbar"><div><span id="result-count" class="result-count">0 resultados</span><span id="pagination-count" class="pagination-count"></span></div><label class="sort-control"><span data-job-i18n="sortBy">Ordenar por</span><select id="sort-opportunities"><option value="relevance" data-job-i18n="relevance">Relevância</option><option value="date" data-job-i18n="newest">Mais recentes</option><option value="salary" data-job-i18n="salaryHigh">Salário mais elevado</option></select></label></div><p class="search-method-note"><span data-job-i18n="relevanceNote">A relevância é calculada por correspondência textual, sem análise por IA.</span><span data-job-i18n="currencyNote">Não é feita conversão entre moedas.</span></p><div id="opportunity-results" class="opportunity-results" aria-live="polite"></div><div id="empty-search-state" class="opportunity-empty-state" hidden><div class="empty-state-icon">⌕</div><h2 data-job-i18n="noResults">Não encontrámos oportunidades com estes critérios.</h2><p data-job-i18n="tryClear">Limpar filtros ou alterar os termos de pesquisa.</p></div><div id="no-jobs-state" class="opportunity-empty-state" hidden><div class="empty-state-icon">◌</div><h2 data-job-i18n="noJobs">Não há anúncios disponíveis neste conjunto demonstrativo.</h2></div><button id="load-more-jobs" class="button button-outline load-more-button" type="button" hidden data-job-i18n="loadMore">Carregar mais</button></section>
  <dialog id="save-search-dialog" class="profile-dialog job-dialog"><form id="save-search-form"><div class="dialog-heading"><div><div class="eyebrow"><span></span><span data-job-i18n="saveSearchTitle">Guardar pesquisa</span></div><h2 data-job-i18n="saveSearch">Guardar pesquisa</h2></div><button type="button" class="dialog-close" id="close-save-search" aria-label="Fechar">×</button></div><label class="profile-field"><span data-job-i18n="name">Nome da pesquisa</span><input name="name" required maxlength="70" data-job-placeholder="namePlaceholder" placeholder="Ex.: Desenvolvimento remoto"/></label><div class="dialog-actions"><button type="button" class="button button-outline" id="cancel-save-search" data-job-i18n="cancel">Cancelar</button><button type="submit" class="button button-primary" data-job-i18n="save">Guardar</button></div></form></dialog>
  <div id="job-feedback" class="profile-message" role="status" aria-live="polite" hidden></div>
  <script src="../../scripts/opportunity-search-page.ts"></script>
</AppLayout>



