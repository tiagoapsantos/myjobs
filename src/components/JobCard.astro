---
import Icon from './Icon.astro'; const {job,compact=false}=Astro.props as {job:{company:string;mark:string;tone:string;role:string;location:string;type:string;age:string;tags:string[];match:string};compact?:boolean};
---
<article class:list={['job-card',{compact}]}><div class:list={['job-company-mark',`tone-${job.tone}`]}>{job.mark}</div><div class="job-main"><div class="job-heading"><div><h3>{job.role}</h3><p>{job.company} <span class="verified-dot">✓</span></p></div><button class="save-button" aria-label="Guardar oportunidade, demonstrativo"><Icon name="bookmark" size={18}/></button></div><div class="job-meta"><span><Icon name="pin" size={14}/>{job.location}</span><span><Icon name="briefcase" size={14}/>{job.type}</span><span><Icon name="clock" size={14}/>{job.age}</span></div><div class="job-footer"><div class="tag-list">{job.tags.map((tag)=><span class="skill-tag">{tag}</span>)}</div><span class="match-badge"><i></i>{job.match} compatibilidade</span></div></div></article>


